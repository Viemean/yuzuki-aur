# Maintainer: Yueyuri <lxf74663@gmail.com>
pkgname=xnconvert
pkgver=1.111.0
pkgrel=1
pkgdesc="XnConvert is a fast, powerful and free cross-platform batch image converter."
arch=('x86_64')
url="https://www.xnview.com/en/xnconvert/"
license=('custom:freeware')
depends=('hicolor-icon-theme' 'glibc')
provides=('xnconvert')
conflicts=('xnconvert')
options=('!strip')
source=("https://download.xnview.com/old_versions/XnConvert/XnConvert-${pkgver}-linux-x64.tgz")
sha256sums=('e2f1ad8d9f6d0b8297016e45319929248dae491faa7fa439d891da315b3cb32e')

prepare() {
    cd "${srcdir}/XnConvert"

    cat > xnconvert.sh << 'EOF'
#!/bin/sh
dirname="$(dirname "$(readlink -e "$0")")"
export LD_LIBRARY_PATH="$dirname"/lib
export QT_PLUGIN_PATH="$dirname"/lib
exec "$dirname"/XnConvert "$@"
EOF

    sed -i 's|^Exec=.*|Exec=/opt/XnConvert/xnconvert.sh|' XnConvert.desktop
    sed -i 's|^Icon=.*|Icon=xnconvert|' XnConvert.desktop
}

package() {
    cd "${srcdir}/XnConvert"

    install -d "${pkgdir}/opt/XnConvert"
    install -d "${pkgdir}/usr/bin"
    install -d "${pkgdir}/usr/share/applications"
    install -d "${pkgdir}/usr/share/pixmaps"
    install -d "${pkgdir}/usr/share/licenses/${pkgname}"

    if [ -f "license.txt" ]; then
        install -Dm644 license.txt "${pkgdir}/usr/share/licenses/${pkgname}/license.txt"
    fi
    install -Dm644 xnconvert.png "${pkgdir}/usr/share/pixmaps/xnconvert.png"
    install -Dm644 XnConvert.desktop "${pkgdir}/usr/share/applications/xnconvert.desktop"

    rm -f license.txt xnconvert.png XnConvert.desktop README qt.conf

    cp -a * "${pkgdir}/opt/XnConvert/"

    find "${pkgdir}/opt/XnConvert" -type d -exec chmod 755 {} +
    find "${pkgdir}/opt/XnConvert" -type f -exec chmod 644 {} +

    chmod 755 "${pkgdir}/opt/XnConvert/XnConvert"
    chmod 755 "${pkgdir}/opt/XnConvert/xnconvert.sh"

    find "${pkgdir}/opt/XnConvert/lib" -name "*.so*" -exec chmod 755 {} + 2>/dev/null || true

    ln -sf /opt/XnConvert/xnconvert.sh "${pkgdir}/usr/bin/xnconvert"
}
